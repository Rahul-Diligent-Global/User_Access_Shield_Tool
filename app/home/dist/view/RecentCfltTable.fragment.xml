<core:FragmentDefinition xmlns:mvc="sap.ui.core.mvc" xmlns:l="sap.ui.layout" xmlns:f="sap.ui.layout.form" xmlns:core="sap.ui.core" xmlns="sap.m" xmlns:layout="sap.ui.layout" xmlns:uxap="sap.uxap" xmlns:upload="sap.m.upload">

					<Table id="conflictsTable" items="{/recentConflicts}">
                        <columns>
                            <Column>
                                <Text text="User"/>
                            </Column>
                            <Column>
                                <Text text="Rule"/>
                            </Column>
                            <Column>
                                <Text text="Severity"/>
                            </Column>
                            <Column>
                                <Text text="Status"/>
                            </Column>
                        </columns>
                        <items>
                            <ColumnListItem>
                                <cells>
                                    <Text text="{user}"/>
                                    <Text text="{rule}"/>
                                    <ObjectStatus text="{severity}" state="{statusState}"/>
                                    <Text text="{status}"/>
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>
</core:FragmentDefinition>
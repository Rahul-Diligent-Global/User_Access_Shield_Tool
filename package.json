{
  "name": "User_Access_Shield_Tool",
  "version": "1.0.0",
  "description": "A simple CAP project.",
  "repository": "<Add your repository here>",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@sap/cds": "^8",
    "express": "^4",
    "@sap/xssec": "^4"
  },
  "devDependencies": {
    "@cap-js/cds-types": "^0.8.0",
    "@cap-js/sqlite": "^1",
    "@sap/cds-dk": "^8"
  },
  "scripts": {
    "start": "cds-serve",
    "watch-home": "cds watch --open home/webapp/index.html?sap-ui-xx-viewCache=false",
    "undeploy": "cf undeploy User_Access_Shield_Tool --delete-services --delete-service-keys --delete-service-brokers",
    "build": "rimraf resources mta_archives && mbt build --mtar archive",
    "deploy": "cf deploy mta_archives/archive.mtar --retries 1"
  },
  "sapux": [
    "app/home"
  ],
  "cds": {
    "requires": {
      "auth": "mocked",
      "connectivity": true,
      "destinations": true,
      "html5-repo": true
    }
  }
}
